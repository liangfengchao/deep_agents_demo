# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key

# 或者使用其他模型提供商
# ANTHROPIC_API_KEY=your-anthropic-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key

# 可选：Tavily Search API (用于网页搜索工具)
# TAVILY_API_KEY=your-tavily-api-key

# 可选：LangSmith (用于追踪调试)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-api-key

# ------------------------------------------------------------
# Demo 09：腾讯文档 MCP 连接器
# Token 获取：https://docs.qq.com/open/auth/mcp.html
# Header 的 key 必须是 Authorization（由代码注入，此处只填 Token 值）
# ------------------------------------------------------------
# TENCENT_DOCS_TOKEN=你的Token
# TENCENT_DOCS_MCP_URL=https://docs.qq.com/openapi/mcp
# TENCENT_DOCS_DEMO_PROMPT=请列出我最近能访问的文档（只读）
